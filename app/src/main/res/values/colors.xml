<?xml version="1.0" encoding="utf-8"?>
<!--
  银昼（默认浅色主题）
  与网页内核 assets/styles.css、assets/themes.css 的银昼配色保持一致。
  深色（蓝夜）配色见 values-night/colors.xml。
-->
<resources>
    <color name="colorPrimary">#81709F</color>
    <color name="colorPrimaryDark">#70608C</color>
    <color name="colorAccent">#81709F</color>

    <color name="bg">#F0F0F7</color>
    <color name="bg_card">#FFFEFD</color>
    <color name="bg_cell">#F6F6FA</color>
    <color name="border">#DCDCE8</color>
    <color name="text">#36374D</color>
    <color name="text_muted">#73748A</color>
    <color name="accent">#81709F</color>

    <color name="day_color">#5483A5</color>
    <color name="night_color">#8A73B0</color>
    <color name="rest_color">#4D8B68</color>
    <color name="noon_color">#A17A35</color>
    <color name="morning_color">#398E8B</color>
    <color name="evening_color">#B57091</color>

    <!-- 自适应图标背景（取自原图边缘平均色） -->
    <color name="ic_launcher_background">#8A576A</color>
    <color name="widget_surface">#FFFEFD</color>
    <color name="widget_surface_end">#F2F3FA</color>
    <color name="widget_panel">#EBEDF6</color>
    <color name="widget_stroke">#D8DBE9</color>
    <color name="widget_ink">#34364E</color>
    <!--
      次要文字与强调色：按 WCAG AA（正文 4.5）取最差背景下的对比度门槛。
      旧值 #70768D / #786695 在 widget_panel(#EBEDF6) 上只有 3.85 / 4.35，小字号会发灰。
      新值最差对比度：widget_muted 5.34、widget_accent 5.04（背景取 surface/surface_end/panel/badge 中最差者）。
    -->
    <color name="widget_muted">#5A6076</color>
    <color name="widget_accent">#6E5C8B</color>
    <color name="widget_orbit">#BCC5DF</color>
    <color name="widget_badge">#EEF1F7</color>
    <!--
      人物对白气泡，取自网页 companion.css 的主题变量：
      companion-paper #fffefd、companion-wash #f2ecfa、companion-line #d8cde6。
      RemoteViews 没有阴影，用描边加左上角渐变代替网页的 box-shadow 高光。
    -->
    <color name="widget_bubble_fill">#FFFEFD</color>
    <color name="widget_bubble_wash">#F2ECFA</color>
    <color name="widget_bubble_stroke">#D8CDE6</color>
</resources>