<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_container" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_card_background">
    <FrameLayout android:id="@+id/card_content" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:id="@+id/header_position" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:baselineAligned="false">
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.271739130">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.000000000">
                            <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/header_size" android:width="152dp" android:height="18dp" android:visibility="invisible" android:importantForAccessibility="no" android:includeFontPadding="false"/>
                                <LinearLayout android:id="@+id/card_header" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false" android:paddingLeft="0dp" android:paddingTop="0dp" android:paddingRight="40dp" android:paddingBottom="0dp" android:layout_alignLeft="@id/header_size" android:layout_alignTop="@id/header_size" android:layout_alignRight="@id/header_size" android:layout_alignBottom="@id/header_size">
                                    <TextView android:id="@+id/today_date" android:layout_width="wrap_content" android:layout_height="match_parent" style="@style/WidgetCardLabel" android:gravity="center_vertical" android:text="10/19 周一" android:textSize="12dp"/>
                                </LinearLayout>
                            </RelativeLayout>
                        </FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.000000000"/>
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.728260870"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/hero_position" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:baselineAligned="false">
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.782608696">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.000000000">
                            <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/hero_size" android:width="152dp" android:height="36dp" android:visibility="invisible" android:importantForAccessibility="no" android:includeFontPadding="false"/>
                                <FrameLayout android:id="@+id/hero_section" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_alignLeft="@id/hero_size" android:layout_alignTop="@id/hero_size" android:layout_alignRight="@id/hero_size" android:layout_alignBottom="@id/hero_size">
                                    <LinearLayout android:id="@+id/shift_row" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
                                        <TextView android:id="@+id/shift_emoji" android:layout_width="wrap_content" android:layout_height="match_parent" style="@style/WidgetCardText" android:gravity="center_vertical" android:text="☀️" android:importantForAccessibility="no" android:textSize="18dp"/>
                                        <TextView android:id="@+id/shift_name" android:layout_width="wrap_content" android:layout_height="match_parent" style="@style/WidgetCardName" android:gravity="center_vertical" android:text="白班" android:paddingLeft="4dp" android:paddingTop="0dp" android:paddingRight="0dp" android:paddingBottom="0dp" android:textSize="24dp"/>
                                        <TextView android:id="@+id/shift_status" android:layout_width="wrap_content" android:layout_height="match_parent" style="@style/WidgetCardLabel" android:gravity="center_vertical" android:text="已结束" android:visibility="visible" android:paddingLeft="6dp" android:paddingTop="0dp" android:paddingRight="0dp" android:paddingBottom="0dp" android:textSize="12dp"/>
                                    </LinearLayout>
                                    <TextView android:id="@+id/shift_time" android:layout_width="match_parent" android:layout_height="match_parent" style="@style/WidgetCardLabel" android:gravity="center_vertical" android:text="已结束 · 08:00–20:00" android:visibility="gone" android:textSize="12dp"/>
                                </FrameLayout>
                            </RelativeLayout>
                        </FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.000000000"/>
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.217391304"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/countdown_position" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:baselineAligned="false">
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.304347826"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.695652174">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.000000000">
                            <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/countdown_size" android:width="152dp" android:height="52dp" android:visibility="invisible" android:importantForAccessibility="no" android:includeFontPadding="false"/>
                                <LinearLayout android:id="@+id/countdown_block" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:baselineAligned="false" android:layout_alignLeft="@id/countdown_size" android:layout_alignTop="@id/countdown_size" android:layout_alignRight="@id/countdown_size" android:layout_alignBottom="@id/countdown_size">
                                    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="18">
                                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
                                            <TextView android:id="@+id/countdown_label" android:layout_width="wrap_content" android:layout_height="match_parent" style="@style/WidgetCardLabel" android:gravity="center_vertical" android:text="距上班" android:textSize="12dp"/>
                                            <TextView android:id="@+id/countdown_detail" android:layout_width="0dp" android:layout_height="match_parent" style="@style/WidgetCardLabel" android:gravity="center_vertical" android:text="10/20 20:00 · 夜班" android:layout_weight="1" android:visibility="gone" android:paddingLeft="12dp" android:paddingTop="0dp" android:paddingRight="0dp" android:paddingBottom="0dp" android:textSize="12dp"/>
                                        </LinearLayout>
                                    </FrameLayout>
                                    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="34">
                                        <FrameLayout android:id="@+id/timer_line" android:layout_width="match_parent" android:layout_height="match_parent">
                                            <FrameLayout android:id="@+id/countdown_container" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
                                                <Chronometer android:id="@+id/countdown_chronometer" android:layout_width="match_parent" android:layout_height="match_parent" style="@style/WidgetCardTimer" android:gravity="start|center_vertical" android:visibility="gone" android:textSize="28dp"/>
                                            </FrameLayout>
                                            <TextView android:id="@+id/countdown_text" android:layout_width="match_parent" android:layout_height="match_parent" style="@style/WidgetCardTimer" android:gravity="center_vertical" android:text="23:07:21" android:textSize="28dp"/>
                                        </FrameLayout>
                                    </FrameLayout>
                                </LinearLayout>
                            </RelativeLayout>
                        </FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.000000000"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/clock_position" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:baselineAligned="false">
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.728260870"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.271739130">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.000000000">
                            <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/clock_size" android:width="152dp" android:height="18dp" android:visibility="invisible" android:importantForAccessibility="no" android:includeFontPadding="false"/>
                                <LinearLayout android:id="@+id/clock_row" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false" android:layout_alignLeft="@id/clock_size" android:layout_alignTop="@id/clock_size" android:layout_alignRight="@id/clock_size" android:layout_alignBottom="@id/clock_size">
                                    <TextView android:id="@+id/clock_label" android:layout_width="wrap_content" android:layout_height="match_parent" style="@style/WidgetCardLabel" android:gravity="center_vertical" android:text="现在" android:textSize="12dp"/>
                                    <TextClock android:id="@+id/live_clock" android:layout_width="wrap_content" android:layout_height="match_parent" style="@style/WidgetCardLabel" android:gravity="center_vertical" android:format12Hour="HH:mm:ss" android:format24Hour="HH:mm:ss" android:fontFeatureSettings="tnum" android:paddingLeft="4dp" android:paddingTop="0dp" android:paddingRight="0dp" android:paddingBottom="0dp" android:textSize="12dp"/>
                                </LinearLayout>
                            </RelativeLayout>
                        </FrameLayout>
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.000000000"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/refresh_position" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingLeft="0dp" android:paddingTop="1dp" android:paddingRight="5dp" android:paddingBottom="0dp">
        <RelativeLayout android:id="@+id/refresh_touch_target" android:layout_width="wrap_content" android:layout_height="wrap_content" android:foreground="@drawable/widget_refresh_feedback" android:focusable="true" android:contentDescription="@string/widget_refresh" android:paddingLeft="11dp" android:paddingTop="11dp" android:paddingRight="11dp" android:paddingBottom="11dp" android:layout_gravity="top|right">
            <ImageView android:id="@+id/refresh_button" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:background="@drawable/widget_refresh_button" android:src="@drawable/widget_refresh" android:scaleType="fitCenter" android:importantForAccessibility="no" android:layout_alignLeft="@id/refresh_size" android:layout_alignTop="@id/refresh_size" android:layout_alignRight="@id/refresh_size" android:layout_alignBottom="@id/refresh_size"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/refresh_size" android:width="26dp" android:height="26dp" android:visibility="invisible" android:importantForAccessibility="no" android:includeFontPadding="false"/>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
