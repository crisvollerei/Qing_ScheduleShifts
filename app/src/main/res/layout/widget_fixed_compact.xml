<?xml version="1.0" encoding="utf-8"?>
<!--
  紧凑方卡：日期 / 班次(名 + 状态 + 时段) / 倒计时 / 当前时间。

  状态与时段拆成两行 wrap_content：真机的「待上班 · 20:00–次日 08:00」比设计稿
  的「已结束 · 08:00–20:00」长得多，合成一行必然被省略号截断。
  块间弹性间隔吸收全部尺寸差异，文字行高交给 Android 实测。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/today_date"
                style="@style/WidgetCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10/20 周二"
                android:textSize="13dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/hero_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/shift_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <FrameLayout
                    android:id="@+id/shift_emoji_box"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:importantForAccessibility="no">

                    <TextView
                        android:id="@+id/shift_emoji"
                        style="@style/WidgetCardText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="🌙"
                        android:textSize="20dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/shift_name"
                    style="@style/WidgetCardName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="6dp"
                    android:text="夜班"
                    android:textSize="20dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/shift_status"
                style="@style/WidgetCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="待上班"
                android:visibility="visible"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/shift_time"
                style="@style/WidgetCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20:00–次日 08:00"
                android:visibility="visible"
                android:textSize="13dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/countdown_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/countdown_label"
                style="@style/WidgetCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="距上班"
                android:textSize="13dp" />

            <FrameLayout
                android:id="@+id/timer_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/countdown_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <Chronometer
                        android:id="@+id/countdown_chronometer"
                        style="@style/WidgetCardTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/countdown_text"
                    style="@style/WidgetCardTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="23:07:21"
                    android:textSize="28dp" />

                <TextView
                    android:id="@+id/countdown_detail"
                    style="@style/WidgetCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:visibility="gone"
                    android:textSize="13dp" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/clock_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/clock_label"
                style="@style/WidgetCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="现在"
                android:textSize="13dp" />

            <TextClock
                android:id="@+id/live_clock"
                style="@style/WidgetCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:format12Hour="HH:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:paddingLeft="4dp"
                android:textSize="13dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
