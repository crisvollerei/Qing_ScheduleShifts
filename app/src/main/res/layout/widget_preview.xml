<?xml version="1.0" encoding="utf-8"?>
<!--
  小部件选择器里的静态预览：与 widget_layout_mini 结构一致，只把动态内容替换成示例值。
  RemoteViews 只允许 @RemoteView 控件，这里同样只用 FrameLayout / LinearLayout / TextView /
  ImageView / Chronometer / TextClock / ProgressBar。

  保持与运行态一致的排版：内容壳 padding = widget_inset_mini（圆角安全区），
  四个核心块之间放等权弹性间隔，次级信息紧贴班次名。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_mini">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-35dp"
        android:layout_marginEnd="-35dp"
        android:src="@drawable/widget_orbit"
        android:alpha="0.18"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_inset_mini">

        <TextView
            android:id="@+id/today_date"
            style="@style/WidgetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:minHeight="@dimen/widget_refresh_size"
                android:gravity="center_vertical"
            android:layout_marginEnd="@dimen/widget_header_reserve_mini"
            android:text="10/17 周六"
            android:textSize="@dimen/widget_text_date_0" />
        <LinearLayout
            android:id="@+id/spring_1"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/shift_emoji"
                style="@style/WidgetText"
                android:layout_width="@dimen/widget_emoji_box_mini"
                android:layout_height="@dimen/widget_emoji_box_mini"
                android:gravity="center"
                android:ellipsize="none"
                android:text="&#x2600;&#xFE0F;"
                android:textSize="@dimen/widget_text_emoji_0"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/shift_name"
                style="@style/WidgetText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/widget_rhythm_mini_2"
                android:fontFamily="sans-serif-medium"
                android:text="白班"
                android:textSize="@dimen/widget_text_name_0" />
        </LinearLayout>

        <TextView
            android:id="@+id/shift_title"
            style="@style/WidgetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_rhythm_mini_1"
            android:text="@string/widget_shift_title"
            android:textColor="@color/widget_accent"
            android:textStyle="bold"
            android:textSize="@dimen/widget_text_label_0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shift_status"
            style="@style/WidgetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_rhythm_mini_1"
            android:paddingStart="@dimen/widget_rhythm_mini_2"
            android:paddingEnd="@dimen/widget_rhythm_mini_2"
            android:background="@drawable/widget_companion_note"
            android:text="正在上班"
            android:textColor="@color/widget_accent"
            android:textSize="@dimen/widget_text_label_0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shift_time"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_rhythm_mini_1"
            android:text="08:00–20:00"
            android:textSize="@dimen/widget_text_detail_0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cycle_info"
            style="@style/WidgetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_rhythm_mini_2"
            android:text="周期 1/8"
            android:textSize="@dimen/widget_text_label_0"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_progress_mini"
            android:layout_marginTop="@dimen/widget_rhythm_mini_2"
            android:minHeight="0dp"
            android:maxHeight="@dimen/widget_progress_mini"
            android:background="@drawable/widget_slot"
            android:progressDrawable="@drawable/progress_bar"
            android:indeterminate="false"
            android:max="8"
            android:progress="7" />

        <TextView
            android:id="@+id/next_shifts"
            style="@style/WidgetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_rhythm_mini_2"
            android:maxLines="1"
            android:text="白班 3天后"
            android:textSize="@dimen/widget_text_label_0"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/spring_2"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="true">

            <TextView
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_now"
                android:textSize="@dimen/widget_text_label_0" />

            <TextClock
                android:id="@+id/live_clock"
                style="@style/WidgetTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:format12Hour="HH:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_clock_0" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/spring_3"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/countdown_label"
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="距下班"
                android:textColor="@color/widget_accent"
                android:textSize="@dimen/widget_text_label_0" />

            <Chronometer
                android:id="@+id/countdown_chronometer"
                style="@style/WidgetTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="@dimen/widget_text_timer_0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/countdown_text"
                style="@style/WidgetTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="07:12:34"
                android:textSize="@dimen/widget_text_timer_0" />
        </LinearLayout>

        <TextView
            android:id="@+id/countdown_detail"
            style="@style/WidgetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_rhythm_mini_1"
            android:textSize="@dimen/widget_text_detail_0"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/companion_portrait"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/refresh_button"
        android:layout_width="@dimen/widget_refresh_size"
        android:layout_height="@dimen/widget_refresh_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/widget_inset_mini"
        android:layout_marginEnd="@dimen/widget_inset_mini"
        android:padding="@dimen/widget_refresh_padding_mini"
        android:scaleType="fitCenter"
        android:background="@drawable/widget_refresh_button"
        android:src="@drawable/widget_refresh"
        android:contentDescription="@string/widget_refresh" />
</FrameLayout>
