<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/widget_container">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_handbook_background"
        android:id="@android:id/background" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="14dp"
        android:id="@+id/card_content">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:baselineAligned="false"
            android:layout_weight="1.1"
            android:id="@+id/shift_column">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:id="@+id/today_date"
                style="@style/WidgetHandbookLabel"
                android:text="10/20 周二" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.8"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:id="@+id/shift_row">
                <FrameLayout
                    android:layout_width="25dp"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:gravity="center"
                        android:id="@+id/shift_emoji"
                        android:visibility="gone"
                        style="@style/WidgetHandbookGlyph"
                        android:text="🌙"
                        android:ellipsize="none" />
                    <ImageView
                        android:id="@+id/shift_symbol"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_symbol_night"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:id="@+id/shift_name"
                    style="@style/WidgetHandbookName"
                    android:text="夜班" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:id="@+id/shift_status"
                style="@style/WidgetHandbookLabel"
                android:text="待上班" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:id="@+id/shift_time"
                style="@style/WidgetHandbookValue"
                android:text="20:00–次日 08:00" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widget_stroke"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="no"
            android:id="@+id/column_divider" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:baselineAligned="false"
            android:layout_weight="1.08"
            android:id="@+id/countdown_column">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.7"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:id="@+id/clock_row">
                <TextView
                    android:layout_width="42dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="6dp"
                    android:layout_height="match_parent"
                    android:id="@+id/clock_label"
                    style="@style/WidgetHandbookLabel"
                    android:text="现在" />
                <TextClock
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:id="@+id/live_clock"
                    style="@style/WidgetHandbookClock"
                    android:format12Hour="HH:mm:ss"
                    android:format24Hour="HH:mm:ss" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:baselineAligned="false"
                android:layout_weight="1.5"
                android:background="@drawable/widget_handbook_panel"
                android:padding="7dp"
                android:id="@+id/countdown_block">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:id="@+id/countdown_label"
                    style="@style/WidgetHandbookLabel"
                    android:text="距上班" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.9"
                    android:id="@+id/timer_line">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:id="@+id/countdown_container">
                        <Chronometer
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:id="@+id/countdown_chronometer"
                            style="@style/WidgetHandbookTimer" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/countdown_text"
                        style="@style/WidgetHandbookTimer"
                        android:text="02:48:05" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:id="@+id/countdown_detail"
                        style="@style/WidgetHandbookLabel"
                        android:text="" />
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.78"
            android:layout_marginLeft="8dp"
            android:importantForAccessibility="no"
            android:id="@+id/portrait_position">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_companion"
                android:importantForAccessibility="no"
                android:id="@+id/companion_portrait" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
