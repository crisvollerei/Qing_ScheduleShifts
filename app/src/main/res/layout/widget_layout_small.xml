<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-65dp"
        android:layout_marginEnd="-65dp"
        android:src="@drawable/widget_orbit"
        android:alpha="0.28"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <TextView
                    android:id="@+id/shift_title"
                    style="@style/WidgetLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="@string/widget_shift_title" />
                <TextView
                    android:id="@+id/today_date"
                    style="@style/WidgetLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/refresh_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="3dp"
                android:src="@drawable/widget_refresh"
                android:contentDescription="@string/widget_refresh"
                android:background="@drawable/widget_badge" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="43dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">
                <TextView
                    android:id="@+id/shift_emoji"
                    style="@style/WidgetText"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/shift_name"
                        style="@style/WidgetText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:id="@+id/shift_status"
                        style="@style/WidgetLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/shift_time"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/cycle_info"
            style="@style/WidgetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp" />
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:minHeight="0dp"
            android:maxHeight="4dp"
            android:progressDrawable="@drawable/progress_bar"
            android:indeterminate="false"
            android:max="8"
            android:progress="7" />
        <TextView
            android:id="@+id/next_shifts"
            style="@style/WidgetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:maxLines="2"
            android:layout_marginTop="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:baselineAligned="false">
            <TextView
                style="@style/WidgetLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_now" />
            <TextClock
                android:id="@+id/live_clock"
                style="@style/WidgetTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:textSize="18sp"
                android:textColor="@color/widget_ink" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/widget_panel"
            android:padding="6dp">
            <TextView
                android:id="@+id/countdown_label"
                style="@style/WidgetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_accent"
                android:textSize="10sp" />
            <Chronometer
                android:id="@+id/countdown_chronometer"
                style="@style/WidgetTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="21sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/countdown_text"
                style="@style/WidgetTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="21sp" />
            <TextView
                android:id="@+id/countdown_detail"
                style="@style/WidgetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
