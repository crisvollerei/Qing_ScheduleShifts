<?xml version="1.0" encoding="utf-8"?>
<!--
  最小卡：日期 / 班次 / 倒计时 / 当前时间。

  四块内容全部 wrap_content，块间只放一条弹性间隔。空间紧时（110×110）间隔
  自己缩到 0，内容按真实字形高度排满；空间富余时也只是间隔变大，不会把元素
  拉开成一盘散沙。emoji 放在固定方框里，不参与文字行高计算。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/today_date"
                style="@style/WidgetCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10/20"
                android:textSize="11dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/hero_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/shift_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <FrameLayout
                    android:id="@+id/shift_emoji_box"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:importantForAccessibility="no">

                    <TextView
                        android:id="@+id/shift_emoji"
                        style="@style/WidgetCardText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="🌙"
                        android:textSize="16dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/shift_name"
                    style="@style/WidgetCardName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="5dp"
                    android:text="夜班"
                    android:textSize="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/shift_status"
                style="@style/WidgetCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待上班"
                android:visibility="gone"
                android:textSize="11dp" />

            <TextView
                android:id="@+id/shift_time"
                style="@style/WidgetCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20:00–次日 08:00"
                android:visibility="gone"
                android:textSize="11dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <!--
          倒计时块：标签与数字并排，右侧留给底部那行碎碎念。
          最小卡只有 128dp，纵向塞不下「标签 / 数字 / 时钟 / 文案」四行，
          所以标签挪到数字左侧，横向吃满整行宽度。
        -->
        <LinearLayout
            android:id="@+id/countdown_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/timer_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/countdown_label"
                    style="@style/WidgetCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingRight="4dp"
                    android:text="距上班"
                    android:textSize="11dp" />

                <FrameLayout
                    android:id="@+id/timer_line"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <FrameLayout
                        android:id="@+id/countdown_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                    <Chronometer
                        android:id="@+id/countdown_chronometer"
                        style="@style/WidgetCardTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:visibility="gone" />
                </FrameLayout>

                    <TextView
                        android:id="@+id/countdown_text"
                        style="@style/WidgetCardTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="23:07:21"
                        android:textSize="23dp" />

                    <TextView
                        android:id="@+id/countdown_detail"
                        style="@style/WidgetCardLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:visibility="gone"
                        android:textSize="11dp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <!-- 最小卡只放当前时间：128dp 里塞不下人物碎碎念，硬放会挤掉倒计时。 -->
        <LinearLayout
            android:id="@+id/clock_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextClock
                android:id="@+id/live_clock"
                style="@style/WidgetCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:format12Hour="HH:mm:ss"
                android:format24Hour="HH:mm:ss"
                android:textSize="11dp" />
        </LinearLayout>
    </LinearLayout>


</FrameLayout>