<?xml version="1.0" encoding="utf-8"?>
<!--
  mini 档：最小尺寸（短边 &lt; 180dp：110x110 / 110x216 / 180x110 / 224x110 / 240x215 …）。

  排版规则（六套布局共用，token 全部在 res/values/dimens.xml）：
    · 内容壳 padding = widget_inset_mini（10dp），四边都 &gt;= 宿主圆角的安全下限
      a = R*(1-1/√2) = 8.20dp（R=28），所以任意矩形都不会落进宿主圆角；
    · 结构上分成「四个核心块」——日期 / 班次名 / 此刻+时钟 / 距下班+倒计时，
      核心块之间放等权弹性间隔（spring_1..spring_4）。弹性间隔只分剩余高度，
      空间不足时自动归零，所以内容永远不会被挤出卡片；
      空间富余时四段间隙完全相等，不会出现「上面挤成一团、下面空一大块」；
    · 次级信息（状态 / 时段 / 周期 / 后续排班 / 副标题）以固定节拍紧贴班次名之后，
      高度不够时由 Provider 整块撤掉（visibilityFor），撤掉时不留空隙；
    · 显示哪些块由 Provider 按可用高度决定。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_mini">

    <!-- 装饰：允许溢出被宿主圆角裁切（它是氛围）；内容壳的内边距保证它不与任何文字/数据重叠。 -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-35dp"
        android:layout_marginEnd="-35dp"
        android:src="@drawable/widget_orbit"
        android:alpha="0.18"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/widget_inset_mini"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 核心块 1：日期 -->
            <TextView
                android:id="@+id/today_date"
                style="@style/WidgetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/widget_refresh_size"
                android:gravity="center_vertical"
                android:layout_marginEnd="@dimen/widget_header_reserve_mini"
                android:textSize="@dimen/widget_text_date_0" />
            <LinearLayout
                android:id="@+id/spring_1"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 核心块 2：班次名 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/shift_emoji"
                    style="@style/WidgetText"
                    android:layout_width="@dimen/widget_emoji_box_mini"
                    android:layout_height="@dimen/widget_emoji_box_mini"
                    android:gravity="center"
                    android:ellipsize="none"
                    android:textSize="@dimen/widget_text_emoji_0"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/shift_name"
                    style="@style/WidgetText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/widget_rhythm_mini_2"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="@dimen/widget_text_name_0" />
            </LinearLayout>

            <!-- 次级信息：紧贴班次名，固定节拍；任何一块被撤都不会留下空隙。 -->
            <TextView
                android:id="@+id/shift_title"
                style="@style/WidgetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_rhythm_mini_1"
                android:textColor="@color/widget_accent"
                android:textStyle="bold"
                android:textSize="@dimen/widget_text_label_0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/shift_status"
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_rhythm_mini_1"
                android:paddingStart="@dimen/widget_rhythm_mini_2"
                android:paddingEnd="@dimen/widget_rhythm_mini_2"
                android:background="@drawable/widget_companion_note"
                android:textColor="@color/widget_accent"
                android:textSize="@dimen/widget_text_label_0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/shift_time"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_rhythm_mini_1"
                android:textSize="@dimen/widget_text_detail_0" />

            <TextView
                android:id="@+id/cycle_info"
                style="@style/WidgetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_rhythm_mini_2"
                android:textSize="@dimen/widget_text_label_0" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_progress_mini"
                android:layout_marginTop="@dimen/widget_rhythm_mini_2"
                android:minHeight="0dp"
                android:maxHeight="@dimen/widget_progress_mini"
                android:background="@drawable/widget_slot"
                android:progressDrawable="@drawable/progress_bar"
                android:indeterminate="false" />

            <TextView
                android:id="@+id/next_shifts"
                style="@style/WidgetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_rhythm_mini_2"
                android:maxLines="1"
                android:textSize="@dimen/widget_text_label_0" />

            <LinearLayout
                android:id="@+id/spring_2"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 核心块 3：此刻 + 实时时钟（同一行，基线对齐） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/clock_label"
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_now"
                    android:textSize="@dimen/widget_text_label_0" />

                <TextClock
                    android:id="@+id/live_clock"
                    style="@style/WidgetTimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:format12Hour="HH:mm:ss"
                    android:format24Hour="HH:mm:ss"
                    android:textColor="@color/widget_ink"
                    android:textSize="@dimen/widget_text_clock_0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/spring_3"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 核心块 4：距下班 + 倒计时（同一行，数值右对齐） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/countdown_label"
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_accent"
                    android:textSize="@dimen/widget_text_label_0" />

                <Chronometer
                    android:id="@+id/countdown_chronometer"
                    style="@style/WidgetTimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="@dimen/widget_text_timer_0"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/countdown_text"
                    style="@style/WidgetTimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="@dimen/widget_text_timer_0" />
            </LinearLayout>

            <TextView
                android:id="@+id/countdown_detail"
                style="@style/WidgetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_rhythm_mini_1"
                android:textSize="@dimen/widget_text_detail_0" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/spring_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 伴侣立绘：独立侧栏列。底部对齐 —— 于是它永远在右上角刷新按钮之下。 -->
        <ImageView
            android:id="@+id/companion_portrait"
            android:layout_width="@dimen/widget_portrait_mini"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_refresh_size"
            android:adjustViewBounds="true"
            android:maxHeight="@dimen/widget_portrait_height_mini"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/widget_companion_gap_mini"
            android:visibility="gone"
            android:src="@drawable/widget_companion"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:focusable="false" />
    </LinearLayout>

    <!-- 刷新：距右、距顶各一个安全内边距；26dp 触控区。 -->
    <ImageView
        android:id="@+id/refresh_button"
        android:layout_width="@dimen/widget_refresh_size"
        android:layout_height="@dimen/widget_refresh_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/widget_inset_mini"
        android:layout_marginEnd="@dimen/widget_inset_mini"
        android:padding="@dimen/widget_refresh_padding_mini"
        android:scaleType="fitCenter"
        android:background="@drawable/widget_refresh_button"
        android:src="@drawable/widget_refresh"
        android:contentDescription="@string/widget_refresh" />
</FrameLayout>
