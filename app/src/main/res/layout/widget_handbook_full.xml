<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/widget_container">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_handbook_background"
        android:id="@android:id/background" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:padding="14dp"
        android:id="@+id/card_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.35"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:id="@+id/card_header">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:baselineAligned="false"
                android:layout_weight="1"
                android:id="@+id/date_stack">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:id="@+id/today_date"
                    style="@style/WidgetHandbookLabel"
                    android:text="10月20日 周二" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:id="@+id/clock_row">
                    <TextView
                        android:layout_width="42dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="6dp"
                        android:layout_height="match_parent"
                        android:id="@+id/clock_label"
                        style="@style/WidgetHandbookLabel"
                        android:text="现在" />
                    <TextClock
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:id="@+id/live_clock"
                        style="@style/WidgetHandbookClock"
                        android:format12Hour="HH:mm:ss"
                        android:format24Hour="HH:mm:ss" />
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:src="@drawable/widget_handbook_trim"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/header_ornament" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4.1"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:id="@+id/hero_section">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:baselineAligned="false"
                android:layout_weight="1.15"
                android:id="@+id/shift_column">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:baselineAligned="false"
                    android:layout_weight="1.7"
                    android:id="@+id/shift_information">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2.4"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        android:id="@+id/shift_row">
                        <FrameLayout
                            android:layout_width="25dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:gravity="center"
                                android:id="@+id/shift_emoji"
                        android:visibility="gone"
                                style="@style/WidgetHandbookGlyph"
                                android:text="🌙"
                                android:ellipsize="none" />
                            <ImageView
                                android:id="@+id/shift_symbol"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:src="@drawable/widget_symbol_night"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:id="@+id/shift_name"
                            style="@style/WidgetHandbookName"
                            android:text="夜班" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:id="@+id/shift_status"
                        style="@style/WidgetHandbookLabel"
                        android:text="待上班" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:id="@+id/shift_time"
                        style="@style/WidgetHandbookValue"
                        android:text="20:00–次日 08:00" />
                </LinearLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:baselineAligned="false"
                    android:layout_weight="1.5"
                    android:background="@drawable/widget_handbook_panel"
                    android:padding="7dp"
                    android:id="@+id/countdown_block">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:id="@+id/countdown_label"
                        style="@style/WidgetHandbookLabel"
                        android:text="距上班" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.9"
                        android:id="@+id/timer_line">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:id="@+id/countdown_container">
                            <Chronometer
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone"
                                android:id="@+id/countdown_chronometer"
                                style="@style/WidgetHandbookTimer" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/countdown_text"
                            style="@style/WidgetHandbookTimer"
                            android:text="02:48:05" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:id="@+id/countdown_detail"
                            style="@style/WidgetHandbookLabel"
                            android:text="" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:baselineAligned="false"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:importantForAccessibility="no"
                android:id="@+id/portrait_position">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/widget_companion"
                    android:scaleType="fitEnd"
                    android:importantForAccessibility="no"
                    android:id="@+id/companion_portrait" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:id="@+id/portrait_note"
                    style="@style/WidgetHandbookLabel"
                    android:text="今天也陪着你" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.65"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:background="@drawable/widget_handbook_panel"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:id="@+id/tomorrow_row">
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:id="@+id/tomorrow_label"
                style="@style/WidgetHandbookLabel"
                android:text="明日 · 10/21" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:gravity="end|center_vertical"
                android:id="@+id/tomorrow_value"
                style="@style/WidgetHandbookValue"
                android:text="🌿 休息 · 全天放松" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:baselineAligned="false"
            android:layout_weight="2.05"
            android:id="@+id/week_section">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_stroke"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.9"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:layout_marginTop="3dp"
                android:id="@+id/week_header">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:id="@+id/week_title"
                    style="@style/WidgetHandbookLabel"
                    android:text="未来七天" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:gravity="end|center_vertical"
                    android:id="@+id/cycle_info"
                    style="@style/WidgetHandbookLabel"
                    android:text="周期 2/8" />
                <ProgressBar
                    android:layout_width="26dp"
                    android:layout_height="3dp"
                    android:layout_marginLeft="5dp"
                    android:layout_gravity="center_vertical"
                    android:max="8"
                    android:progress="2"
                    android:progressDrawable="@drawable/progress_bar"
                    android:indeterminate="false"
                    android:id="@+id/progress_bar"
                    style="?android:attr/progressBarStyleHorizontal" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.6"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:id="@+id/week_days">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:background="@drawable/widget_handbook_cell"
                    android:id="@+id/week_day_0"
                    style="@style/WidgetHandbookWeek"
                    android:text="21&#10;🌿" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:background="@drawable/widget_handbook_cell"
                    android:id="@+id/week_day_1"
                    style="@style/WidgetHandbookWeek"
                    android:text="22&#10;🌿" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:background="@drawable/widget_handbook_cell"
                    android:id="@+id/week_day_2"
                    style="@style/WidgetHandbookWeek"
                    android:text="23&#10;🌿" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:background="@drawable/widget_handbook_cell"
                    android:id="@+id/week_day_3"
                    style="@style/WidgetHandbookWeek"
                    android:text="24&#10;🌿" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:background="@drawable/widget_handbook_cell"
                    android:id="@+id/week_day_4"
                    style="@style/WidgetHandbookWeek"
                    android:text="25&#10;🌿" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:background="@drawable/widget_handbook_cell"
                    android:id="@+id/week_day_5"
                    style="@style/WidgetHandbookWeek"
                    android:text="26&#10;🌿" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="1dp"
                    android:layout_marginRight="1dp"
                    android:background="@drawable/widget_handbook_cell"
                    android:id="@+id/week_day_6"
                    style="@style/WidgetHandbookWeek"
                    android:text="27&#10;🌿" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
