<?xml version="1.0" encoding="utf-8"?>
<!--
  完整卡：日期时间 / 班次+立绘 / 倒计时 / 未来七天。

  每个内容块都是 wrap_content，块与块之间只放一条弹性间隔。文字行高由 Android
  实测决定，剩余空间全部由间隔吸收：启动器的内边距差异只会让间隔变窄或变宽，
  不会压缩字形、也不会把 emoji 顶离班名。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <!-- 日期与当前时间 -->
        <LinearLayout
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/today_date"
                style="@style/WidgetCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10月19日 周一"
                android:textSize="15dp" />

            <LinearLayout
                android:id="@+id/clock_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/clock_label"
                    style="@style/WidgetCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="现在"
                    android:textSize="15dp" />

                <TextClock
                    android:id="@+id/live_clock"
                    style="@style/WidgetCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="HH:mm:ss"
                    android:format24Hour="HH:mm:ss"
                    android:paddingLeft="4dp"
                    android:textSize="15dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <!-- 班次：文字在左，立绘在右 -->
        <LinearLayout
            android:id="@+id/hero_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/shift_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="100"
                android:orientation="vertical"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/shift_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <FrameLayout
                        android:id="@+id/shift_emoji_box"
                        android:layout_width="39dp"
                        android:layout_height="39dp"
                        android:importantForAccessibility="no">

                        <TextView
                            android:id="@+id/shift_emoji"
                            style="@style/WidgetCardText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:text="☀️"
                            android:textSize="25dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/shift_name"
                        style="@style/WidgetCardName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="7dp"
                        android:text="白班"
                        android:textSize="25dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/shift_status"
                    style="@style/WidgetCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="待上班"
                    android:visibility="visible"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/shift_time"
                    style="@style/WidgetCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="20:00–次日 08:00"
                    android:visibility="visible"
                    android:textSize="15dp" />

            </LinearLayout>

            <!--
              人物列：立绘在上，碎碎念在下。
              文案放在人物正下方，读起来就是角色本人在说话；放进班次块会和班名挤在一起。
            -->
            <!--
              人物列按权重分宽，而不是写死 118dp：
              卡片被拉到 224dp 宽时固定宽度会把文字列挤没了，
              按 100:37 分就能等比收缩。
            -->
            <LinearLayout
                android:id="@+id/portrait_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="37"
                android:orientation="vertical"
                android:baselineAligned="false">

                <ImageView
                    android:id="@+id/companion_portrait"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_companion" />

            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <!-- 倒计时 -->
        <LinearLayout
            android:id="@+id/countdown_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/countdown_label"
                style="@style/WidgetCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="距上班"
                android:textSize="15dp" />

            <FrameLayout
                android:id="@+id/timer_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/countdown_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <Chronometer
                        android:id="@+id/countdown_chronometer"
                        style="@style/WidgetCardTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/countdown_text"
                    style="@style/WidgetCardTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="23:07:21"
                    android:textSize="36dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/countdown_detail"
                style="@style/WidgetCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10/20 20:00 · 夜班"
                android:visibility="visible"
                android:textSize="15dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <!-- 未来七天：用 minHeight 占住「标题行 + 日期符号两行」的实际高度，
             否则上面的弹性间隔会把剩余空间吃光，把周条压到卡片外。 -->
        <LinearLayout
            android:id="@+id/week_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            android:orientation="vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/week_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/week_title"
                    style="@style/WidgetCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未来七天"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/cycle_info"
                    style="@style/WidgetCardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="周期 2/8"
                    android:textSize="15dp" />

                <FrameLayout
                    android:id="@+id/progress_position"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingLeft="6dp">

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_gravity="center_vertical"
                        android:max="8"
                        android:progress="2"
                        android:progressDrawable="@drawable/progress_bar" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/week_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/week_day_0"
                    style="@style/WidgetCardWeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:text="20&#10;🌙"
                    android:textAlignment="center"
                    android:textSize="15dp" />
                <TextView
                    android:id="@+id/week_day_1"
                    style="@style/WidgetCardWeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:text="21&#10;🌿"
                    android:textAlignment="center"
                    android:textSize="15dp" />
                <TextView
                    android:id="@+id/week_day_2"
                    style="@style/WidgetCardWeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:text="22&#10;☀️"
                    android:textAlignment="center"
                    android:textSize="15dp" />
                <TextView
                    android:id="@+id/week_day_3"
                    style="@style/WidgetCardWeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:text="23&#10;🌙"
                    android:textAlignment="center"
                    android:textSize="15dp" />
                <TextView
                    android:id="@+id/week_day_4"
                    style="@style/WidgetCardWeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:text="24&#10;🌿"
                    android:textAlignment="center"
                    android:textSize="15dp" />
                <TextView
                    android:id="@+id/week_day_5"
                    style="@style/WidgetCardWeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:text="25&#10;🌿"
                    android:textAlignment="center"
                    android:textSize="15dp" />
                <TextView
                    android:id="@+id/week_day_6"
                    style="@style/WidgetCardWeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:text="26&#10;🌿"
                    android:textAlignment="center"
                    android:textSize="15dp" />
            </LinearLayout>


        </LinearLayout>
    </LinearLayout>

</FrameLayout>