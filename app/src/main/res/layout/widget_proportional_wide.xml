<?xml version="1.0" encoding="utf-8"?>
<!--
  横条：班次 | 倒计时 | 立绘 三段式。

  三段各自占一列，立绘独占最右一段，不再挤在倒计时旁边。
  每列内部用「内容 wrap_content + 弹性间隔 weight=1」的结构：文字行永远按
  Android 实测的字形高度排，剩余空间交给间隔吸收。这样启动器少给或多给
  十几 dp，都只是间隔变窄或变宽，不会把文字压扁、也不会把 emoji 顶离班名。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <!-- 第一段：日期 + 班次 -->
        <LinearLayout
            android:id="@+id/shift_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="150"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/card_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/today_date"
                    style="@style/WidgetCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10/19 周一"
                    android:textSize="13dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hero_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/shift_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <!-- 固定方框承载 emoji：尺寸由渲染器设定，不跟随文字行高 -->
                    <FrameLayout
                        android:id="@+id/shift_emoji_box"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no">

                        <TextView
                            android:id="@+id/shift_emoji"
                            style="@style/WidgetCardText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:text="☀️"
                            android:textSize="21dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/shift_name"
                        style="@style/WidgetCardName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="6dp"
                        android:text="白班"
                        android:textSize="21dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/shift_status"
                    style="@style/WidgetCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="待上班"
                    android:visibility="visible"
                    android:textSize="13dp" />

                <TextView
                    android:id="@+id/shift_time"
                    style="@style/WidgetCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="20:00–次日 08:00"
                    android:visibility="visible"
                    android:textSize="13dp" />
            </LinearLayout>


        </LinearLayout>

        <!-- RemoteViews 只允许白名单控件，裸 <View> 会抛 "Class not allowed to be inflated"， -->
        <!-- 所以分隔线也用 FrameLayout 画。 -->
        <FrameLayout
            android:id="@+id/column_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/widget_stroke"
            android:importantForAccessibility="no" />

        <!--
          第二段：当前时间 + 倒计时，整组套在气泡里。

          气泡右下收角、左上大圆角，指向右侧人物——读起来是"人物在旁边报时间"。
          气泡只包这一组，不掺班次信息，避免满屏都是框。
        -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="118"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="14dp">

        <LinearLayout
            android:id="@+id/countdown_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/widget_bubble"
            android:orientation="vertical"
            android:baselineAligned="false"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/clock_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/clock_label"
                    style="@style/WidgetCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="现在"
                    android:textSize="13dp" />

                <TextClock
                    android:id="@+id/live_clock"
                    style="@style/WidgetCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="HH:mm:ss"
                    android:format24Hour="HH:mm:ss"
                    android:paddingLeft="4dp"
                    android:textSize="13dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/countdown_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/countdown_label"
                    style="@style/WidgetCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="距上班"
                    android:textSize="13dp" />

                <!-- minHeight 兜住极扁卡片：字号 18dp 时行高至少要 22dp，
                     否则字形上下会被父级的剩余空间裁掉。 -->
                <FrameLayout
                    android:id="@+id/timer_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="22dp">

                    <FrameLayout
                        android:id="@+id/countdown_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                    <Chronometer
                        android:id="@+id/countdown_chronometer"
                        style="@style/WidgetCardTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:visibility="gone" />
                </FrameLayout>

                    <TextView
                        android:id="@+id/countdown_text"
                        style="@style/WidgetCardTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:text="23:07:21"
                        android:textSize="30dp" />

                    <TextView
                        android:id="@+id/countdown_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        </FrameLayout>

        <!-- 第三段：立绘独占 -->
        <FrameLayout
            android:id="@+id/portrait_position"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="74"
            android:importantForAccessibility="no">

            <!--
              立绘贴底，上边距只让出刷新触摸区真正占用的那一块。

              刷新触摸区固定在右上角（48dp 见方，靠右 5dp），而立绘段落在它的左半侧
              之外——两者只在上部分重叠。所以上边距取 48dp 的七成即可，
              不必整条留满，省下的高度都还给立绘。
            -->
            <ImageView
                android:id="@+id/companion_portrait"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:layout_marginTop="16dp"
                android:adjustViewBounds="false"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_companion" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>