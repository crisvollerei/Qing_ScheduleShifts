<?xml version="1.0" encoding="utf-8"?>
<!--
  小尺寸（2x2 及矮宽）卡片背景，见 widget_background.xml 的说明。
  半径同样引用 @dimen/widget_corner_radius，与宿主裁切半径一致，描边不会被切角。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:startColor="@color/widget_surface" android:endColor="@color/widget_surface_end" android:angle="315" />
    <stroke android:width="1dp" android:color="@color/widget_stroke" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
