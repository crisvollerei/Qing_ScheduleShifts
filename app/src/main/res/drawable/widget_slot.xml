<?xml version="1.0" encoding="utf-8"?>
<!--
  进度条与行内标签共用的透明占位底。

  进度条没有 android:background（轨道由 progressDrawable 画），行内「此刻」标签
  同样没有底。它们在「垂直节奏」判断里不算内容块，于是自身高度会被误读成
  相邻块之间的空隙。用一个全透明底让它们作为独立内容块参与计算，
  视觉上没有任何变化，但节奏计算就一致了。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
