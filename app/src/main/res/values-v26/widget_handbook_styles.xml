<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Auto-size uses measured host bounds, not the launcher's advertised dp size. -->
    <style name="WidgetHandbookLabel" parent="WidgetCardLabel">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:scrollHorizontally">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">4dp</item>
        <item name="android:autoSizeMaxTextSize">20sp</item>
        <item name="android:autoSizeStepGranularity">1dp</item>
    </style>
    <style name="WidgetHandbookValue" parent="WidgetHandbookLabel">
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:autoSizeMaxTextSize">22sp</item>
    </style>
    <style name="WidgetHandbookClock" parent="WidgetHandbookValue">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">16sp</item>
        <item name="android:autoSizeMaxTextSize">24sp</item>
    </style>
    <style name="WidgetHandbookName" parent="WidgetHandbookLabel">
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">32sp</item>
        <item name="android:autoSizeMinTextSize">6dp</item>
        <item name="android:autoSizeMaxTextSize">40sp</item>
    </style>
    <style name="WidgetHandbookGlyph" parent="WidgetHandbookName">
        <!-- A single emoji cluster cannot wrap: bound its maximum to its icon box. -->
        <item name="android:autoSizeMinTextSize">2dp</item>
        <item name="android:autoSizeMaxTextSize">18dp</item>
    </style>
    <style name="WidgetHandbookTimer" parent="WidgetHandbookLabel">
        <item name="android:fontFamily">serif</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/widget_accent</item>
        <item name="android:textSize">34sp</item>
        <item name="android:ellipsize">none</item>
        <item name="android:autoSizeMinTextSize">3dp</item>
        <item name="android:autoSizeMaxTextSize">56sp</item>
    </style>
    <style name="WidgetHandbookWeek" parent="WidgetHandbookValue">
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">none</item>
    </style>
</resources>
